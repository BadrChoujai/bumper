# Copy to .env and fill in once you've created the accounts.
# Nothing here is required to run the server locally — it works with
# every value unset, it just can't sell Pro yet.

PORT=8787

# Postgres connection string. Works with Supabase, Neon, Railway Postgres,
# or a plain `postgres://user:pass@host:5432/db` you run yourself.
# Run `npm run migrate` once against it before starting the server.
DATABASE_URL=

# Stripe (test mode keys start with sk_test_ / whsec_ — use those until you're
# ready to go live). From: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint you create pointing at POST /webhook/stripe
STRIPE_WEBHOOK_SECRET=
# The Price ID for the Pro subscription product you create in Stripe
STRIPE_PRICE_ID=

CHECKOUT_SUCCESS_URL=https://bumper-guard.pages.dev/
CHECKOUT_CANCEL_URL=https://bumper-guard.pages.dev/#pricing

# Free-plan monthly quota, in "ask" events. Kept configurable here rather
# than hardcoded so it's a one-line change once you have real usage data.
FREE_ASKS_PER_MONTH=15
